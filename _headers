# Cabeçalhos do Cloudflare Pages.
# O mais importante aqui é o cache: dados.json muda toda vez que a
# arrecadação é atualizada, então ele NÃO pode ficar preso em cache.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# imagens e logo: nome fixo, conteúdo estável -> cache longo
/assets/*
  Cache-Control: public, max-age=604800

# a campanha em si: sempre revalida, para a atualização aparecer na hora
/dados.json
  Cache-Control: public, max-age=60, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# página da diretoria: fora dos buscadores
/relatorio.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=0, must-revalidate
